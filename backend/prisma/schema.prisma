datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

enum UserRole {
  ADMIN
  ACCOUNTING
  CASHIER
  KITCHEN
  WAREHOUSE
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum OrderSource {
  SELF_ORDER
  CASHIER
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QRIS
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum PromotionType {
  PERCENT
  PACKAGE
}

enum SellableProductType {
  DIRECT_SALE
  RECIPE_BASED
}

enum WarehouseType {
  SALES
  KITCHEN_STORAGE
  GENERAL
}

enum StockMovementType {
  OPENING
  RECEIVE
  SALE
  ADJUSTMENT
  WASTE
  TRANSFER_OUT
  TRANSFER_IN
  RECIPE_CONSUMPTION
}

enum StockReferenceType {
  OPENING
  RECEIVE
  SALE
  ADJUSTMENT
  WASTE
  TRANSFER
  RECIPE_CONSUMPTION
}

enum StockTransferStatus {
  DRAFT
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  COMPLETED
  CANCELLED
}

enum StockRequestStatus {
  PENDING
  FULFILLING
  SHIPPED
  RECEIVED
  ACCEPTED
  CANCELLED
}

enum CashierShiftStatus {
  OPEN
  CLOSED
}

enum BaseUnit {
  G
  ML
  PCS
}

model User {
  id                              String              @id @default(uuid())
  fullName                        String
  username                        String              @unique
  passwordHash                    String
  role                            UserRole
  isActive                        Boolean             @default(true)
  createdAt                       DateTime            @default(now())
  updatedAt                       DateTime            @updatedAt
  orders                          Order[]
  promotions                      Promotion[]
  auditLogs                       AuditLog[]
  orderTimelines                  OrderTimeline[]
  confirmedPayments               Payment[]           @relation(name: "ConfirmedPayments")
  cashierShifts                   CashierShift[]
  stockLedgers                    StockLedger[]
  warehouseId                     String?
  warehouse                       Warehouse?          @relation(fields: [warehouseId], references: [id])
  stockTransfersRequested         StockTransfer[]     @relation("StockTransferRequestedBy")
  stockTransfersSourceResponsible StockTransfer[]     @relation("StockTransferSourceResponsible")
  stockTransfersDestinationResponsible StockTransfer[] @relation("StockTransferDestinationResponsible")
  stockTransfersCompleted         StockTransfer[]     @relation("StockTransferCompletedBy")
  stockRequestsRequested          StockRequest[]      @relation("StockRequestRequester")
  stockRequestsSource             StockRequest[]      @relation("StockRequestSourceUser")

  @@index([role])
  @@index([isActive])
}

model Category {
  id              String            @id @default(uuid())
  name            String
  isActive        Boolean           @default(true)
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  materials       Material[]
  sellableProducts SellableProduct[]

  @@index([isActive])
  @@index([deletedAt])
}

model Brand {
  id              String            @id @default(uuid())
  name            String            @unique
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  materials       Material[]
  sellableProducts SellableProduct[]

  @@index([isActive])
}

model Material {
  id          String           @id @default(uuid())
  brandId     String?
  brand       Brand?           @relation(fields: [brandId], references: [id])
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    MaterialVariant[]

  @@index([brandId])
  @@index([categoryId])
  @@index([isActive])
}

model MaterialVariant {
  id                     String                   @id @default(uuid())
  materialId             String
  material               Material                 @relation(fields: [materialId], references: [id])
  name                   String
  variantCode            String?
  specification          String?
  baseUnit               BaseUnit
  sku                    String?                  @unique
  barcode                String?                  @unique
  isActive               Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  inventoryStocks        InventoryStock[]
  stockLedgers           StockLedger[]
  recipeItems            RecipeItem[]
  packagingConfigurations PackagingConfiguration[]
  supplierOffers         SupplierOffer[]
  stockTransferItems     StockTransferItem[]
  stockRequestItems      StockRequestItem[]
  purchaseReceiptItems   PurchaseReceiptItem[]
  warehouseLocations     WarehouseMaterialVariantLocation[]
  wasteRecords           Waste[]
  adjustmentRecords      Adjustment[]
  pickingRecords         Picking[]
  directSaleProducts     SellableProduct[]        @relation("DirectSaleMaterialVariant")

  @@index([materialId])
  @@index([sku])
  @@index([variantCode])
  @@index([barcode])
  @@index([isActive])
}

model PackagingConfiguration {
  id                String            @id @default(uuid())
  materialVariantId String
  materialVariant   MaterialVariant   @relation(fields: [materialVariantId], references: [id])
  name              String
  unitLabel         String?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  versions          PackagingVersion[]
  offers            SupplierOffer[]
  purchaseReceiptItems PurchaseReceiptItem[]

  @@index([materialVariantId])
  @@index([isActive])
}

model PackagingVersion {
  id                      String                  @id @default(uuid())
  packagingConfigurationId String
  packagingConfiguration   PackagingConfiguration  @relation(fields: [packagingConfigurationId], references: [id])
  versionNumber           Int                     @default(1)
  effectiveFrom           DateTime                @default(now())
  effectiveTo             DateTime?
  isActive                Boolean                 @default(true)
  conversionFactor        Decimal                 @db.Decimal(14, 3)
  normalizedToBaseQuantity Decimal                @db.Decimal(14, 3)
  baseUnit                BaseUnit
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  purchaseReceiptItems    PurchaseReceiptItem[]
  stockLedgers            StockLedger[]

  @@unique([packagingConfigurationId, versionNumber])
  @@index([packagingConfigurationId])
  @@index([effectiveFrom])
  @@index([isActive])
}

model Supplier {
  id        String         @id @default(uuid())
  name      String
  code      String?        @unique
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  offers    SupplierOffer[]
  receipts  PurchaseReceipt[]

  @@index([isActive])
}

model SupplierOffer {
  id                     String                  @id @default(uuid())
  supplierId             String
  supplier               Supplier                @relation(fields: [supplierId], references: [id])
  materialVariantId      String
  materialVariant        MaterialVariant         @relation(fields: [materialVariantId], references: [id])
  packagingConfigurationId String?
  packagingConfiguration  PackagingConfiguration?  @relation(fields: [packagingConfigurationId], references: [id])
  unitPrice              Decimal                 @db.Decimal(12, 2)
  currency               String                  @default("IDR")
  supplierSku            String?
  effectiveFrom          DateTime                @default(now())
  effectiveTo            DateTime?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  purchaseReceiptItems   PurchaseReceiptItem[]

  @@index([supplierId])
  @@index([materialVariantId])
  @@index([packagingConfigurationId])
  @@index([isActive])
}

model SellableProduct {
  id                       String              @id @default(uuid())
  name                     String
  sku                      String?             @unique
  categoryId               String?
  category                 Category?           @relation(fields: [categoryId], references: [id])
  brandId                  String?
  brand                    Brand?              @relation(fields: [brandId], references: [id])
  productType              SellableProductType @default(DIRECT_SALE)
  price                    Decimal?            @db.Decimal(12, 2)
  directSaleMaterialVariantId String?
  directSaleMaterialVariant MaterialVariant?    @relation("DirectSaleMaterialVariant", fields: [directSaleMaterialVariantId], references: [id])
  isActive                 Boolean             @default(true)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  recipe                   Recipe?
  orderItems               OrderItem[]
  promotionItems           PromotionItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([productType])
  @@index([isActive])
}

model Recipe {
  id                String          @id @default(uuid())
  sellableProductId String          @unique
  sellableProduct   SellableProduct @relation(fields: [sellableProductId], references: [id], onDelete: Cascade)
  versionNumber     Int             @default(1)
  effectiveFrom     DateTime        @default(now())
  effectiveTo       DateTime?
  isActive          Boolean         @default(true)
  items             RecipeItem[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([sellableProductId])
  @@index([isActive])
}

model RecipeItem {
  id                String          @id @default(uuid())
  recipeId          String
  recipe            Recipe          @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  materialVariantId String
  materialVariant   MaterialVariant @relation(fields: [materialVariantId], references: [id])
  quantity          Decimal         @db.Decimal(14, 3)
  note              String?
  createdAt         DateTime        @default(now())

  @@index([recipeId])
  @@index([materialVariantId])
}

model Unit {
  id        String   @id @default(uuid())
  name      String
  symbol    String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Table {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  orders    Order[]

  @@index([isActive])
  @@index([deletedAt])
}

model Tax {
  id         String   @id @default(uuid())
  name       String
  percentage Decimal  @db.Decimal(5, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Promotion {
  id           String          @id @default(uuid())
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id])
  name         String
  type         PromotionType
  percentValue Decimal?        @db.Decimal(5, 2)
  packagePrice Decimal?        @db.Decimal(12, 2)
  startDate    DateTime?
  endDate      DateTime?
  isActive     Boolean         @default(true)
  deletedAt    DateTime?
  priority     Int             @default(0)
  stackable    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  items        PromotionItem[]
}

model PromotionItem {
  id             String          @id @default(uuid())
  promotionId    String
  promotion      Promotion       @relation(fields: [promotionId], references: [id])
  sellableProductId String
  sellableProduct SellableProduct @relation(fields: [sellableProductId], references: [id])
  quantity       Int
}

model Order {
  id              String           @id @default(uuid())
  orderNumber     String           @unique
  dailyNumber     Int
  displayNumber   String           @unique
  businessDate    DateTime         @default(now())
  customerName    String
  source          OrderSource      @default(SELF_ORDER)
  cashierId       String?
  cashier         User?            @relation(fields: [cashierId], references: [id])
  tableId         String?
  table           Table?           @relation(fields: [tableId], references: [id])
  orderType       OrderType
  status          OrderStatus
  subtotal        Decimal          @db.Decimal(12, 2)
  discountAmount  Decimal          @db.Decimal(12, 2)
  taxAmount       Decimal          @db.Decimal(12, 2)
  grandTotal      Decimal          @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  items           OrderItem[]
  payments        Payment[]
  orderPromotions OrderPromotion[]
  orderTaxes      OrderTax[]
  timelines      OrderTimeline[]

  @@index([status])
  @@index([status, businessDate])
  @@index([createdAt])
  @@index([businessDate])
  @@index([source])
  @@index([tableId])
  @@index([cashierId])
  @@index([customerName])
}

model OrderItem {
  id                String          @id @default(uuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id])
  sellableProductId String
  sellableProduct   SellableProduct @relation(fields: [sellableProductId], references: [id])
  productName       String
  productSku        String?
  productCategory   String?
  unitPrice         Decimal         @db.Decimal(12, 2)
  quantity          Int
  subtotal          Decimal         @db.Decimal(12, 2)
  promotionName     String?
  discountAmount    Decimal         @db.Decimal(12, 2)
  note              String?
  createdAt         DateTime        @default(now())
  @@index([orderId])
  @@index([createdAt])
  @@index([sellableProductId])
  @@index([productName])
  @@index([productSku])
}

model OrderPromotion {
  id             String        @id @default(uuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  promotionId    String
  name           String
  type           PromotionType
  percentValue   Decimal?      @db.Decimal(5, 2)
  packagePrice   Decimal?      @db.Decimal(12, 2)
  discountAmount Decimal       @db.Decimal(12, 2)
}

model OrderTax {
  id         String  @id @default(uuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id])
  taxId      String
  name       String
  percentage Decimal @db.Decimal(5, 2)
  amount     Decimal @db.Decimal(12, 2)
}

model OrderTimeline {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id])
  status      OrderStatus
  description String?
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id])
  metadata    Json?
  createdAt   DateTime    @default(now())
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  method          PaymentMethod
  status          PaymentStatus
  amount          Decimal       @db.Decimal(12, 2)
  estimatedCash   Decimal?      @db.Decimal(12, 2)
  receivedCash    Decimal?      @db.Decimal(12, 2)
  changeAmount    Decimal?      @db.Decimal(12, 2)
  referenceNumber String?
  confirmedById   String?
  confirmedBy     User?         @relation(name: "ConfirmedPayments", fields: [confirmedById], references: [id])
  confirmedAt     DateTime?
  cashierShiftId  String?
  cashierShift    CashierShift? @relation(fields: [cashierShiftId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([method])
  @@index([confirmedAt])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([method, createdAt])
  @@index([confirmedById])
  @@index([cashierShiftId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  payload   Json?
  createdAt DateTime @default(now())
}

model CashierShift {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  businessDate DateTime           @default(now())
  status       CashierShiftStatus @default(OPEN)
  openedAt     DateTime           @default(now())
  closedAt     DateTime?
  openingCash  Decimal            @db.Decimal(12, 2)
  expectedCash Decimal            @db.Decimal(12, 2) @default(0)
  actualCash   Decimal?           @db.Decimal(12, 2)
  difference   Decimal?           @db.Decimal(12, 2)
  notes        String?
  payments     Payment[]

  @@index([userId])
  @@index([businessDate])
  @@index([status])
}

model Warehouse {
  id                               String             @id @default(uuid())
  code                             String             @unique
  name                             String
  warehouseType                    WarehouseType      @default(SALES)
  isDefaultKitchenStorage          Boolean            @default(false)
  isActive                         Boolean            @default(true)
  createdAt                        DateTime           @default(now())
  updatedAt                        DateTime           @updatedAt
  inventoryStocks                  InventoryStock[]
  stockLedgers                     StockLedger[]
  stockTransfersSource             StockTransfer[]    @relation("StockTransferSourceWarehouse")
  stockTransfersDestination        StockTransfer[]    @relation("StockTransferDestinationWarehouse")
  stockRequestsDestination         StockRequest[]     @relation("StockRequestDestination")
  stockRequestsSource              StockRequest[]     @relation("StockRequestSource")
  warehouseMaterialVariantLocations WarehouseMaterialVariantLocation[]
  users                            User[]
  purchaseReceipts                 PurchaseReceipt[]
  wasteRecords                     Waste[]
  adjustmentRecords                Adjustment[]
  pickingRecords                   Picking[]

  @@index([warehouseType])
  @@index([isActive])
}

model InventoryStock {
  id                String          @id @default(uuid())
  warehouseId       String
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id])
  materialVariantId String
  materialVariant   MaterialVariant @relation(fields: [materialVariantId], references: [id])
  quantity          Decimal         @default(0) @db.Decimal(14, 3)
  updatedAt         DateTime        @updatedAt

  @@unique([warehouseId, materialVariantId])
  @@index([warehouseId])
  @@index([materialVariantId])
}

model StockLedger {
  id                  String             @id @default(uuid())
  warehouseId         String
  warehouse           Warehouse          @relation(fields: [warehouseId], references: [id])
  materialVariantId   String
  materialVariant     MaterialVariant    @relation(fields: [materialVariantId], references: [id])
  packagingVersionId  String?
  packagingVersion    PackagingVersion?  @relation(fields: [packagingVersionId], references: [id])
  movementType        StockMovementType
  quantity            Decimal            @db.Decimal(14, 3)
  quantityBefore      Decimal            @db.Decimal(14, 3)
  quantityAfter       Decimal            @db.Decimal(14, 3)
  referenceType       StockReferenceType
  referenceId         String?
  remarks             String?
  createdById         String?
  createdBy           User?              @relation(fields: [createdById], references: [id])
  createdAt           DateTime           @default(now())

  @@index([warehouseId])
  @@index([materialVariantId])
  @@index([movementType])
  @@index([createdAt])
  @@index([referenceType])
  @@index([referenceId])
}

model WarehouseMaterialVariantLocation {
  id                String          @id @default(uuid())
  warehouseId       String
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id])
  materialVariantId String
  materialVariant   MaterialVariant @relation(fields: [materialVariantId], references: [id])
  locationCode      String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([warehouseId, materialVariantId, locationCode])
  @@index([warehouseId])
  @@index([materialVariantId])
}

model StockTransfer {
  id                               String               @id @default(uuid())
  transferNumber                   String               @unique
  sourceWarehouseId                String
  sourceWarehouse                  Warehouse            @relation("StockTransferSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destinationWarehouseId           String
  destinationWarehouse             Warehouse            @relation("StockTransferDestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  requestedById                    String
  requestedBy                      User                 @relation("StockTransferRequestedBy", fields: [requestedById], references: [id])
  sourceResponsibleUserId          String?
  sourceResponsibleUser            User?                @relation("StockTransferSourceResponsible", fields: [sourceResponsibleUserId], references: [id])
  destinationResponsibleUserId     String?
  destinationResponsibleUser       User?                @relation("StockTransferDestinationResponsible", fields: [destinationResponsibleUserId], references: [id])
  completedById                    String?
  completedBy                      User?                @relation("StockTransferCompletedBy", fields: [completedById], references: [id])
  completedAt                      DateTime?
  status                           StockTransferStatus  @default(DRAFT)
  remarks                          String?
  items                            StockTransferItem[]
  stockRequestId                   String?              @unique
  stockRequest                     StockRequest?        @relation(fields: [stockRequestId], references: [id])
  createdAt                        DateTime             @default(now())
  updatedAt                        DateTime             @updatedAt
}

model StockTransferItem {
  id                String          @id @default(uuid())
  transferId        String
  transfer          StockTransfer   @relation(fields: [transferId], references: [id])
  materialVariantId String
  materialVariant   MaterialVariant @relation(fields: [materialVariantId], references: [id])
  quantity          Decimal         @db.Decimal(14, 3)
  createdAt         DateTime        @default(now())

  @@index([transferId])
  @@index([materialVariantId])
}

model StockRequest {
  id                    String             @id @default(uuid())
  requestNumber         String             @unique
  requesterId           String
  requestingWarehouseId String
  sourceWarehouseId     String?
  sourceUserId          String?
  status                StockRequestStatus @default(PENDING)
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  claimedAt             DateTime?
  shippedAt             DateTime?
  receivedAt            DateTime?
  acceptedAt            DateTime?

  requester             User               @relation("StockRequestRequester", fields: [requesterId], references: [id])
  sourceUser            User?              @relation("StockRequestSourceUser", fields: [sourceUserId], references: [id])
  requestingWarehouse    Warehouse          @relation("StockRequestDestination", fields: [requestingWarehouseId], references: [id])
  sourceWarehouse        Warehouse?         @relation("StockRequestSource", fields: [sourceWarehouseId], references: [id])
  items                 StockRequestItem[]
  stockTransfer         StockTransfer?
}

model StockRequestItem {
  id                String        @id @default(uuid())
  stockRequestId    String
  materialVariantId String
  quantity          Decimal       @db.Decimal(14, 3)
  stockRequest      StockRequest  @relation(fields: [stockRequestId], references: [id], onDelete: Cascade)
  materialVariant   MaterialVariant @relation(fields: [materialVariantId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([stockRequestId])
  @@index([materialVariantId])
}

model PurchaseReceipt {
  id              String               @id @default(uuid())
  receiptNumber   String               @unique
  supplierId      String
  supplier        Supplier             @relation(fields: [supplierId], references: [id])
  warehouseId     String
  warehouse       Warehouse            @relation(fields: [warehouseId], references: [id])
  receivedAt      DateTime             @default(now())
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  items           PurchaseReceiptItem[]

  @@index([supplierId])
  @@index([warehouseId])
}

model PurchaseReceiptItem {
  id                    String               @id @default(uuid())
  purchaseReceiptId     String
  purchaseReceipt       PurchaseReceipt      @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  materialVariantId     String
  materialVariant       MaterialVariant      @relation(fields: [materialVariantId], references: [id])
  supplierOfferId       String?
  supplierOffer         SupplierOffer?       @relation(fields: [supplierOfferId], references: [id])
  packagingConfigurationId String?
  packagingConfiguration PackagingConfiguration? @relation(fields: [packagingConfigurationId], references: [id])
  packagingVersionId    String?
  packagingVersion      PackagingVersion?    @relation(fields: [packagingVersionId], references: [id])
  quantity              Decimal              @db.Decimal(14, 3)
  unitPrice             Decimal?             @db.Decimal(12, 2)
  createdAt             DateTime             @default(now())

  @@index([purchaseReceiptId])
  @@index([materialVariantId])
  @@index([supplierOfferId])
  @@index([packagingVersionId])
}

model Waste {
  id                String          @id @default(uuid())
  warehouseId       String
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id])
  materialVariantId String
  materialVariant   MaterialVariant @relation(fields: [materialVariantId], references: [id])
  quantity          Decimal         @db.Decimal(14, 3)
  reason            String?
  referenceId       String?
  createdAt         DateTime        @default(now())

  @@index([warehouseId])
  @@index([materialVariantId])
}

model Adjustment {
  id                String          @id @default(uuid())
  warehouseId       String
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id])
  materialVariantId String
  materialVariant   MaterialVariant @relation(fields: [materialVariantId], references: [id])
  quantity          Decimal         @db.Decimal(14, 3)
  reason            String?
  referenceId       String?
  createdAt         DateTime        @default(now())

  @@index([warehouseId])
  @@index([materialVariantId])
}

model Picking {
  id                String          @id @default(uuid())
  warehouseId       String
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id])
  materialVariantId String
  materialVariant   MaterialVariant @relation(fields: [materialVariantId], references: [id])
  quantity          Decimal         @db.Decimal(14, 3)
  status            String          @default("PENDING")
  createdAt         DateTime        @default(now())

  @@index([warehouseId])
  @@index([materialVariantId])
}
