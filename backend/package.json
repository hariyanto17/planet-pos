{
  "name": "pos-retail-backend",
  "version": "1.0.0",
  "description": "POS Retail backend service",
  "main": "dist/backend/src/app.js",
  "scripts": {
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/app.ts",
    "build": "tsc",
    "start": "node -r tsconfig-paths/register dist/backend/src/app.js",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "test": "node --require ts-node/register --test src/modules/inventory/validation.test.ts src/modules/inventory/receiving.test.ts src/modules/materials/service.test.ts src/modules/materials/recipe-compatibility.test.ts"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "@types/socket.io": "^3.0.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "joi": "^17.12.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/qrcode": "^1.5.6",
    "nodemon": "^3.1.0",
    "prisma": "7.8.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
